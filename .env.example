# Daily News Agent Environment Configuration

# 1. Telegram Bot Integration (Get from @BotFather)
# Open Telegram -> Search @BotFather -> send /newbot -> Copy the HTTP API token
TELEGRAM_BOT_TOKEN=

# Send any message to your bot -> get your chat id from @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# 2. LLM Backend (Optional if using Groq or Gemini, otherwise defaults to local Ollama)
GROQ_API_KEY=
GOOGLE_API_KEY=

# Local Ollama config (Default offline backend)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest

